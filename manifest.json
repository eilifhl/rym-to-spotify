{
  "manifest_version": 3,
  "name": "RYM Spotify Link Extractor",
  "version": "3.2",
  "description": "Copy Spotify links and create playlists directly from RateYourMusic charts.",
  "icons": {
    "16": "src/icon.svg",
    "32": "src/icon.svg",
    "48": "src/icon.svg",
    "96": "src/icon.svg"
  },
  "permissions": [
    "identity",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*"
  ],
  "action": {
    "default_icon": "src/icon.svg",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/setup.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "src/actions.js",
      "src/spotify.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://rateyourmusic.com/charts/*",
        "*://www.rateyourmusic.com/charts/*"
      ],
      "js": [
        "src/actions.js",
        "src/chart.js",
        "src/panel.js",
        "src/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{895a470a-7abd-43b8-99d2-e72d4509ba6d}"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css"
      ],
      "matches": [
        "*://rateyourmusic.com/charts/*",
        "*://www.rateyourmusic.com/charts/*"
      ]
    }
  ]
}
